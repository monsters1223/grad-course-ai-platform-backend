# =========================================================
# Docker Compose 配置模板
# ---------------------------------------------------------
# 用法：克隆仓库后，复制此文件为 .env
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
#
# 默认密码 (gradcourse_dev) 可直接用于本地开发，无需修改即可跑通。
# 部署到校内服务器（公网可达）前，务必修改 PG_PASSWORD 与 JWT_SECRET。
# =========================================================

# ----- PostgreSQL 容器初始化账号（db 服务首次启动时建库用）-----
PG_USER=grad_ai
PG_PASSWORD=gradcourse_dev
PG_DB=grad_ai

# ----- 数据库连接串（给 web 服务用）-----
# 主机名必须写 db（compose 服务名），不是 localhost。
# 容器之间靠服务名通信；写 localhost 会连到自己容器的 5432，那里没有数据库。
# PG_PASSWORD 若改动，此处的密码必须同步修改。
DATABASE_URL=postgresql+psycopg2://grad_ai:gradcourse_dev@db:5432/grad_ai

# ----- JWT 签名密钥 -----
# 生产环境生成方式：openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ----- 端口（可选，默认值见 docker-compose.yml）-----
# 若本机 8000 / 5432 端口已被占用，可在此改主机侧端口：
# WEB_PORT=8001
# DB_PORT=5433
