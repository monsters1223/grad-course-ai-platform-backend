# ===== OpenMAIC 云端访问码（必填）=====
# 在 https://open.maic.chat 登录后获取，形如 sk-xxxx
OPENMAIC_ACCESS_CODE=sk-填你的访问码

# OpenMAIC 基地址（一般无需修改）
OPENMAIC_BASE_URL=https://open.maic.chat

# SQLite 数据库文件位置（容器内，配合 docker 卷持久化，一般无需修改）
SQLITE_PATH=/app/data/app.db

# JWT 签名密钥（生产环境务必改成强随机值：openssl rand -hex 32）
JWT_SECRET=请改成随机字符串
