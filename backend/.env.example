# =========================================================
# 后端进程配置模板（Python / pydantic-settings 读取）
# ---------------------------------------------------------
# 用法：复制为 backend/.env
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
#
# 注意：本文件给【后端 Python 进程】用，与上一级的 site/.env（给 Docker Compose 用）
#      是两个不同的文件，不要混用。详见下方说明。
# =========================================================

# ===== OpenMAIC 云端访问码（AI 课堂功能需要）=====
# 在 https://open.maic.chat 登录后获取，形如 sk-xxxx
# D4 接 AI 课堂时若留空，调用 /api/ai/generate 会返回 501
OPENMAIC_ACCESS_CODE=sk-填你的访问码

# OpenMAIC 基地址（一般无需修改）
OPENMAIC_BASE_URL=https://open.maic.chat

# ===== JWT 签名密钥 =====
# 生产环境生成方式：openssl rand -hex 32
# 若走 docker-compose，此值会被 compose 的 environment 覆盖
JWT_SECRET=change-me-in-production

# ===== 数据库连接（可选）=====
# 走 docker-compose 时无需填写 —— DATABASE_URL 由 compose 的 environment 注入。
# 只有在本机直接运行 `python main.py`（不经过 Docker）时才需要填，
# 且主机名要写 localhost（不是 db，因为此时你不在容器网络内）：
# DATABASE_URL=postgresql+psycopg2://grad_ai:gradcourse_dev@localhost:5432/grad_ai

# SQLite 回落路径（未配置 DATABASE_URL 时使用）
# SQLITE_PATH=./app.db
