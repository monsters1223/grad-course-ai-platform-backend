# =========================================================
#  Windows 原生部署环境变量模板
#  用法：复制为 backend\.env 并填写真实值
#    copy deploy\windows\.env.windows.example backend\.env
#  注意：.env 已被 .gitignore 忽略，不会进仓库，属于本机机密文件。
# =========================================================

# ----- OpenMAIC 多智能体课堂（必填）-----
OPENMAIC_BASE_URL=https://open.maic.chat
# 从你本机 site\backend\.env 里复制 OPENMAIC_ACCESS_CODE 的真实值过来
OPENMAIC_ACCESS_CODE=PUT_YOUR_CODE_HERE

# ----- JWT 签名密钥（必填，换成随机串）-----
# 生成： python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=PUT_A_RANDOM_64_HEX_HERE

# ----- 数据库（默认 SQLite，无需安装 PostgreSQL）-----
# 路径用正斜杠；目录必须存在（安装脚本会自动创建）
SQLITE_PATH=C:/gradai/data/app.db

# ----- 运行期数据目录（作业附件等）-----
DATA_DIR=C:/gradai/data

# ----- 可选：改用 PostgreSQL 时才填，填了就优先于 SQLite -----
# DATABASE_URL=postgresql+psycopg2://grad_ai:你的密码@127.0.0.1:5432/grad_ai
